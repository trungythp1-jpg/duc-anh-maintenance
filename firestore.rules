rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /*
     * ĐỨC ANH MAINTENANCE — MODULE 4.8
     * FIRESTORE RULES — TECHNICIAN SCOPE
     *
     * Mục tiêu:
     * - ADMIN / MANAGER giữ quyền quản lý đầy đủ theo Rules hiện tại.
     * - TECHNICIAN chỉ được đọc/sửa công việc được giao cho chính mình.
     * - Liên kết bảo mật:
     *     users/{uid}.technicianId
     *       ↓
     *     maintenance.technicianId
     *       hoặc
     *     workOrders.assignedTechnicianId
     *
     * LƯU Ý:
     * - technicianId là mã nghiệp vụ lâu dài.
     * - Firebase Auth UID chỉ là tài khoản đăng nhập.
     * - Không thêm technicianUid vào maintenance/workOrders.
     * - Trước khi dùng tài khoản TECHNICIAN thật, users/{uid}
     *   phải có technicianId đúng với technicians/{technicianId}.
     */

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    function hasUserDoc() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        );
    }

    function userRole() {
      return hasUserDoc()
        ? userDoc().data.role
        : null;
    }

    function isAdmin() {
      return signedIn()
        && userRole() in ['ADMIN', 'admin'];
    }

    function isManager() {
      return signedIn()
        && userRole() in ['MANAGER', 'manager'];
    }

    function isDirector() {
      return signedIn()
        && userRole() in ['DIRECTOR', 'director'];
    }

    function isCSKH() {
      return signedIn()
        && userRole() in [
          'CUSTOMER_SERVICE',
          'customer_service',
          'CSKH',
          'cskh'
        ];
    }

    function isTechnician() {
      return signedIn()
        && userRole() in ['TECHNICIAN', 'technician'];
    }

    function isWarehouse() {
      return signedIn()
        && userRole() in ['WAREHOUSE', 'warehouse'];
    }

    function technicianIdFromUser() {
      return hasUserDoc()
        ? userDoc().data.get('technicianId', '')
        : '';
    }

    function isAssignedTechnician(technicianId) {
      return isTechnician()
        && technicianIdFromUser() != ''
        && technicianId == technicianIdFromUser();
    }

    function isAssignedWorkOrder() {
      return isTechnician()
        && technicianIdFromUser() != ''
        && resource.data.assignedTechnicianId == technicianIdFromUser();
    }

    function isAssignedMaintenance() {
      return isTechnician()
        && technicianIdFromUser() != ''
        && resource.data.technicianId == technicianIdFromUser();
    }

    function isServiceStaff() {
      return isAdmin()
        || isManager()
        || isDirector()
        || isCSKH()
        || isTechnician();
    }


    // =========================================================
    // USERS
    // =========================================================

    match /users/{userId} {
      allow get: if signedIn()
        && (
          request.auth.uid == userId
          || isAdmin()
          || isManager()
          || isDirector()
        );

      allow list: if isAdmin()
        || isManager()
        || isDirector();

      allow create: if isAdmin();

      allow update: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'name',
              'displayName',
              'phone',
              'photoUrl',
              'updatedAt'
            ])
        );

      allow delete: if false;
    }


    // =========================================================
    // CUSTOMERS / BUILDINGS / ELEVATORS
    // =========================================================
    //
    // Giữ quyền hiện tại cho giai đoạn Module 4.
    // Scope dữ liệu TECHNICIAN trên PBM/WO được khóa ở dưới.
    // Các màn hình TECHNICIAN sẽ không tải toàn bộ các collection
    // này sau khi Permission Test được hoàn thiện.
    //

    match /customers/{customerId} {
      allow read: if isServiceStaff();
      allow create, update: if isAdmin()
        || isManager()
        || isCSKH();
      allow delete: if false;
    }

    match /buildings/{buildingId} {
      allow read: if isServiceStaff();
      allow create, update: if isAdmin()
        || isManager()
        || isCSKH();
      allow delete: if false;
    }

    match /elevators/{elevatorId} {
      allow read: if isServiceStaff();
      allow create, update: if isAdmin()
        || isManager();
      allow delete: if false;
    }

    match /elevatorRelationships/{relationshipId} {
      allow read: if isServiceStaff();
      allow create, update: if isAdmin()
        || isManager();
      allow delete: if false;
    }


    // =========================================================
    // CONTRACTS
    // =========================================================

    match /contracts/{contractId} {
      allow read: if isServiceStaff();

      allow create, update: if isAdmin()
        || isManager()
        || isCSKH();

      allow delete: if false;
    }


    // =========================================================
    // MAINTENANCE
    // =========================================================
    //
    // ADMIN / MANAGER:
    //   đọc và sửa toàn bộ.
    //
    // TECHNICIAN:
    //   chỉ được đọc/sửa PBM có technicianId đúng bằng
    //   users/{uid}.technicianId.
    //
    // Quan trọng:
    // Query TECHNICIAN phải dùng:
    // where("technicianId", "==", users/{uid}.technicianId)
    //
    // Firestore Rules không phải bộ lọc; query không có constraint
    // phù hợp sẽ bị từ chối.
    //

    match /maintenance/{maintenanceId} {
      allow get: if isAdmin()
        || isManager()
        || isDirector()
        || isCSKH()
        || isAssignedMaintenance();

      allow list: if isAdmin()
        || isManager()
        || isDirector()
        || isCSKH()
        || isAssignedMaintenance();

      allow create: if isAdmin()
        || isManager();

      allow update: if isAdmin()
        || isManager()
        || (
          isAssignedMaintenance()
          && request.resource.data.technicianId
             == resource.data.technicianId
          && request.resource.data.technicianId
             == technicianIdFromUser()
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.buildingId == resource.data.buildingId
          && request.resource.data.elevatorId == resource.data.elevatorId
          && request.resource.data.contractId == resource.data.contractId
          && request.resource.data.periodNumber == resource.data.periodNumber
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'customerId','customerName','buildingId','buildingName','elevatorId',
            'elevatorName','elevatorAssetCode','contractId','contractCode','periodNumber',
            'scheduledDate','completedDate','status','technicianId','technicianName',
            'checklist','condition','result','issueFound','note',
            'latestWorkOrderId','latestWorkOrderNo','latestWorkOrderStatus',
            'workOrderIds','workOrderCount','updatedAt'
          ])
        );

      allow delete: if false;
    }


    // =========================================================
    // WORK ORDERS — V2
    // =========================================================
    //
    // Work Order độc lập với Maintenance.
    //
    // sourceType:
    //   MAINTENANCE
    //   CUSTOMER_REPORT
    //   INCIDENT
    //   SALES
    //   MANAGEMENT
    //   OTHER
    //
    // Mọi WO phải có context tài sản:
    //   customerId
    //   buildingId
    //   elevatorId
    //
    // Nếu sourceType == MAINTENANCE:
    //   maintenanceId bắt buộc.
    //
    // TECHNICIAN:
    //   - chỉ đọc/sửa WO được giao cho chính mình.
    //   - không được thay đổi source/asset/contract/maintenance/
    //     assignedTechnicianId.
    //   - chỉ sửa các trường vận hành được phép.
    //
    // Query TECHNICIAN phải dùng:
    //   where("assignedTechnicianId", "==", users/{uid}.technicianId)
    //

    match /workOrders/{workOrderId} {
      allow get: if isAdmin()
        || isManager()
        || isDirector()
        || isCSKH()
        || isAssignedWorkOrder();

      allow list: if isAdmin()
        || isManager()
        || isDirector()
        || isCSKH()
        || isAssignedWorkOrder();

      // Chỉ ADMIN / MANAGER tạo WO chính thức.
      allow create: if
        (isAdmin() || isManager())
        && request.resource.data.sourceType in [
          'MAINTENANCE',
          'CUSTOMER_REPORT',
          'INCIDENT',
          'SALES',
          'MANAGEMENT',
          'OTHER'
        ]
        && request.resource.data.type in [
          'MAINTENANCE', 'BREAKDOWN', 'REPAIR', 'INSPECTION'
        ]
        && request.resource.data.priority in [
          'low', 'normal', 'high', 'urgent'
        ]
        && request.resource.data.status in [
          'draft', 'assigned', 'in_progress', 'waiting_parts', 'completed', 'cancelled'
        ]
        && request.resource.data.customerId != ''
        && request.resource.data.buildingId != ''
        && request.resource.data.elevatorId != ''
        && (
          request.resource.data.sourceType != 'MAINTENANCE'
          || (
            request.resource.data.maintenanceId != ''
            && exists(
              /databases/$(database)/documents/maintenance/$(request.resource.data.maintenanceId)
            )
            && get(
              /databases/$(database)/documents/maintenance/$(request.resource.data.maintenanceId)
            ).data.customerId == request.resource.data.customerId
            && get(
              /databases/$(database)/documents/maintenance/$(request.resource.data.maintenanceId)
            ).data.buildingId == request.resource.data.buildingId
            && get(
              /databases/$(database)/documents/maintenance/$(request.resource.data.maintenanceId)
            ).data.elevatorId == request.resource.data.elevatorId
          )
        );

      // ADMIN / MANAGER có quyền quản lý toàn bộ WO nhưng vẫn phải
      // giữ các invariant cốt lõi của Work Order V2.
      // TECHNICIAN chỉ được sửa WO đang giao cho mình và chỉ được
      // thay đổi các trường vận hành.
      allow update: if
        (
          (isAdmin() || isManager())
          && request.resource.data.sourceType in [
            'MAINTENANCE', 'CUSTOMER_REPORT', 'INCIDENT', 'SALES', 'MANAGEMENT', 'OTHER'
          ]
          && request.resource.data.type in [
            'MAINTENANCE', 'BREAKDOWN', 'REPAIR', 'INSPECTION'
          ]
          && request.resource.data.priority in [
            'low', 'normal', 'high', 'urgent'
          ]
          && request.resource.data.status in [
            'draft', 'assigned', 'in_progress', 'waiting_parts', 'completed', 'cancelled'
          ]
          && request.resource.data.customerId != ''
          && request.resource.data.buildingId != ''
          && request.resource.data.elevatorId != ''
          && (
            request.resource.data.sourceType != 'MAINTENANCE'
            || (
              request.resource.data.maintenanceId != ''
              && exists(
                /databases/$(database)/documents/maintenance/$(request.resource.data.maintenanceId)
              )
              && get(
                /databases/$(database)/documents/maintenance/$(request.resource.data.maintenanceId)
              ).data.customerId == request.resource.data.customerId
              && get(
                /databases/$(database)/documents/maintenance/$(request.resource.data.maintenanceId)
              ).data.buildingId == request.resource.data.buildingId
              && get(
                /databases/$(database)/documents/maintenance/$(request.resource.data.maintenanceId)
              ).data.elevatorId == request.resource.data.elevatorId
            )
          )
        )
        || (
          isAssignedWorkOrder()
          && request.resource.data.assignedTechnicianId
             == resource.data.assignedTechnicianId
          && request.resource.data.assignedTechnicianId
             == technicianIdFromUser()
          && request.resource.data.sourceType
             == resource.data.sourceType
          && request.resource.data.customerId
             == resource.data.customerId
          && request.resource.data.buildingId
             == resource.data.buildingId
          && request.resource.data.elevatorId
             == resource.data.elevatorId
          && request.resource.data.contractId
             == resource.data.contractId
          && request.resource.data.maintenanceId
             == resource.data.maintenanceId
          && request.resource.data.status in [
            'in_progress',
            'completed'
          ]
          && (
            resource.data.status != 'completed'
            || request.resource.data.status == 'completed'
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'completedDate',
            'resolution',
            'completedAt',
            'updatedAt'
          ])
        );

      allow delete: if false;
    }


    // =========================================================
    // TECHNICIANS
    // =========================================================

    match /technicians/{technicianId} {
      allow get: if isAdmin()
        || isManager()
        || isDirector()
        || isCSKH()
        || isAssignedTechnician(technicianId);

      allow list: if isAdmin()
        || isManager()
        || isDirector()
        || isCSKH()
        || (
          isTechnician()
          && technicianIdFromUser() != ''
          && resource.data.technicianId == technicianIdFromUser()
        );

      allow create, update: if isAdmin()
        || isManager();

      allow delete: if false;
    }


    // =========================================================
    // KPI
    // =========================================================

    match /kpi/{kpiId} {
      allow read: if isServiceStaff();
      allow create, update: if isAdmin()
        || isManager();
      allow delete: if false;
    }


    // =========================================================
    // DOCUMENTS
    // =========================================================

    match /documents/{documentId} {
      allow read: if isServiceStaff();
      allow create, update: if isAdmin()
        || isManager()
        || isCSKH();
      allow delete: if false;
    }


    // =========================================================
    // WORK ORDER REQUESTS — V2
    // =========================================================
    //
    // TECHNICIAN không tạo Work Order trực tiếp.
    // TECHNICIAN gửi Request; ADMIN / MANAGER chuyển Request
    // thành Work Order chính thức và phân công KTV.
    //
    // Request độc lập với Maintenance.
    //
    // Nếu sourceType == MAINTENANCE:
    //   maintenanceId bắt buộc và phải thuộc đúng technicianId
    //   của người gửi request.
    //
    // Nếu sourceType != MAINTENANCE:
    //   maintenanceId có thể rỗng.
    //
    // TECHNICIAN chỉ được đọc Request do chính mình gửi.
    // ADMIN / MANAGER / DIRECTOR / CSKH được đọc danh sách.
    //

    match /workOrderRequests/{requestId} {
      allow get: if isAdmin()
        || isManager()
        || isDirector()
        || isCSKH()
        || (
          isTechnician()
          && resource.data.requestedByTechnicianId == technicianIdFromUser()
        );

      allow list: if isAdmin()
        || isManager()
        || isDirector()
        || isCSKH();

      allow create: if
        isTechnician()
        && request.resource.data.sourceType in [
          'MAINTENANCE',
          'CUSTOMER_REPORT',
          'INCIDENT',
          'SALES',
          'MANAGEMENT',
          'OTHER'
        ]
        && request.resource.data.requestedByTechnicianId
           == technicianIdFromUser()
        && request.resource.data.requestedByUid
           == request.auth.uid
        && request.resource.data.status == 'PENDING'
        && request.resource.data.type in [
          'MAINTENANCE', 'BREAKDOWN', 'REPAIR', 'INSPECTION'
        ]
        && request.resource.data.priority in [
          'low', 'normal', 'high', 'urgent'
        ]
        && request.resource.data.customerId != ''
        && request.resource.data.buildingId != ''
        && request.resource.data.elevatorId != ''
        && (
          request.resource.data.sourceType != 'MAINTENANCE'
          || (
            request.resource.data.maintenanceId != ''
            && exists(
              /databases/$(database)/documents/maintenance/$(request.resource.data.maintenanceId)
            )
            && get(
              /databases/$(database)/documents/maintenance/$(request.resource.data.maintenanceId)
            ).data.technicianId == technicianIdFromUser()
          )
        );

      // Chỉ cho phép ADMIN / MANAGER xử lý Request.
      // Dữ liệu nguồn của Request không được sửa sau khi gửi.
      allow update: if
        (isAdmin() || isManager())
        && request.resource.data.status in [
          'PENDING', 'APPROVED', 'REJECTED', 'CONVERTED'
        ]
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'createdWorkOrderId',
          'createdWorkOrderNo',
          'processedByUid',
          'processedByName',
          'processedAt',
          'updatedAt'
        ]);

      allow delete: if false;
    }


    // =========================================================
    // AUDIT LOGS
    // =========================================================

    match /auditLogs/{logId} {
      allow read: if isAdmin()
        || isManager()
        || isDirector();

      allow create: if isServiceStaff();

      allow update, delete: if false;
    }


    // =========================================================
    // SETTINGS
    // =========================================================

    match /settings/{settingId} {
      allow read: if isServiceStaff();

      allow create, update: if
        (settingId == 'maintenanceTicket'
          && (isAdmin() || isManager() || isTechnician()))
        || isAdmin();

      allow delete: if false;
    }


    // =========================================================
    // NOTIFICATIONS
    // =========================================================

    match /notifications/{notificationId} {
      allow read: if isServiceStaff();
      allow create: if isServiceStaff();
      allow update: if isServiceStaff();
      allow delete: if false;
    }


    // =========================================================
    // SERVICE AREAS
    // =========================================================

    match /serviceAreas/{areaId} {
      allow read: if isServiceStaff();
      allow create, update: if isAdmin()
        || isManager();
      allow delete: if false;
    }


    // =========================================================
    // MAINTENANCE SCHEDULES
    // =========================================================

    match /maintenanceSchedules/{scheduleId} {
      allow read: if isServiceStaff();

      allow create, update: if isAdmin()
        || isManager();

      allow delete: if false;
    }


    // =========================================================
    // CHECKLIST TEMPLATES
    // =========================================================

    match /checklistTemplates/{templateId} {
      allow read: if isServiceStaff();

      allow create, update: if isAdmin()
        || isManager();

      allow delete: if false;
    }


    // =========================================================
    // SERVICE CONTRACTS — COMPATIBILITY
    // =========================================================

    match /serviceContracts/{contractId} {
      allow read: if isServiceStaff();

      allow create, update: if isAdmin()
        || isManager()
        || isCSKH();

      allow delete: if false;
    }


    // =========================================================
    // MAINTENANCE AGREEMENTS — COMPATIBILITY
    // =========================================================

    match /maintenanceAgreements/{agreementId} {
      allow read: if isServiceStaff();

      allow create, update: if isAdmin()
        || isManager()
        || isCSKH();

      allow delete: if false;
    }


    // =========================================================
    // DEFAULT DENY
    // =========================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

    
