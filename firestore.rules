rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /*
     * ĐỨC ANH MAINTENANCE — DEV FIRESTORE RULES
     *
     * Mục tiêu:
     * - Tài khoản đã đăng nhập mới được truy cập hệ thống.
     * - Role được đọc từ users/{uid}.role.
     * - Chấp nhận cả role viết HOA và viết thường để tránh lỗi
     *   ADMIN/admin, MANAGER/manager...
     * - Module Hợp đồng sử dụng collection: contracts
     * - Không cho xóa dữ liệu vận hành.
     */

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    function hasUserDoc() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        );
    }

    function userRole() {
      return hasUserDoc()
        ? userDoc().data.role
        : null;
    }

    function isAdmin() {
      return signedIn()
        && userRole() in ['ADMIN', 'admin'];
    }

    function isManager() {
      return signedIn()
        && userRole() in ['MANAGER', 'manager'];
    }

    function isDirector() {
      return signedIn()
        && userRole() in ['DIRECTOR', 'director'];
    }

    function isCSKH() {
      return signedIn()
        && userRole() in [
          'CUSTOMER_SERVICE',
          'customer_service',
          'CSKH',
          'cskh'
        ];
    }

    function isTechnician() {
      return signedIn()
        && userRole() in ['TECHNICIAN', 'technician'];
    }

    function isWarehouse() {
      return signedIn()
        && userRole() in ['WAREHOUSE', 'warehouse'];
    }

    function isServiceStaff() {
      return isAdmin()
        || isManager()
        || isDirector()
        || isCSKH()
        || isTechnician();
    }


    // =========================================================
    // USERS
    // =========================================================

    match /users/{userId} {

      // User được đọc hồ sơ của chính mình.
      // Management/Admin được đọc toàn bộ user.
      allow read: if signedIn()
        && (
          request.auth.uid == userId
          || isAdmin()
          || isManager()
          || isDirector()
        );

      // Chỉ Admin được tạo user.
      allow create: if isAdmin();

      // Admin được sửa user.
      // User thường chỉ được sửa các thông tin cá nhân cơ bản.
      allow update: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'name',
              'displayName',
              'phone',
              'photoUrl',
              'updatedAt'
            ])
        );

      // Không xóa user.
      allow delete: if false;
    }


    // =========================================================
    // CUSTOMERS
    // =========================================================

    match /customers/{customerId} {
      allow read: if isServiceStaff();

      allow create, update: if isAdmin()
        || isManager()
        || isCSKH();

      allow delete: if false;
    }


    // =========================================================
    // BUILDINGS
    // =========================================================

    match /buildings/{buildingId} {
      allow read: if isServiceStaff();

      allow create, update: if isAdmin()
        || isManager()
        || isCSKH();

      allow delete: if false;
    }


    // =========================================================
    // ELEVATORS
    // =========================================================

    match /elevators/{elevatorId} {
      allow read: if isServiceStaff();

      allow create, update: if isAdmin()
        || isManager();

      allow delete: if false;
    }


    // =========================================================
    // ELEVATOR RELATIONSHIPS
    // =========================================================

    match /elevatorRelationships/{relationshipId} {
      allow read: if isServiceStaff();

      allow create, update: if isAdmin()
        || isManager();

      allow delete: if false;
    }


    // =========================================================
    // CONTRACTS — HỢP ĐỒNG
    //
    // contracts.html và firestore-v1.js dùng:
    // collection(db, "contracts")
    // =========================================================

    match /contracts/{contractId} {

      // Administrator/Management/CSKH/Technician được xem.
      allow read: if isServiceStaff();

      // Chỉ Admin, Manager, CSKH được tạo/sửa.
      allow create, update: if isAdmin()
        || isManager()
        || isCSKH();

      // Không xóa hợp đồng.
      allow delete: if false;
    }


    // =========================================================
    // MAINTENANCE
    // =========================================================

    match /maintenance/{maintenanceId} {
      allow read: if isServiceStaff();

      allow create, update: if isAdmin()
        || isManager()
        || isTechnician();

      allow delete: if false;
    }


    // =========================================================
    // WORK ORDERS
    // =========================================================

    match /workOrders/{workOrderId} {
      allow read: if isServiceStaff();

      allow create, update: if isAdmin()
        || isManager()
        || isTechnician();

      allow delete: if false;
    }


    // =========================================================
    // TECHNICIANS
    // =========================================================

    match /technicians/{technicianId} {
      allow read: if isServiceStaff();

      allow create, update: if isAdmin()
        || isManager();

      allow delete: if false;
    }


    // =========================================================
    // KPI
    // =========================================================

    match /kpi/{kpiId} {
      allow read: if isServiceStaff();

      allow create, update: if isAdmin()
        || isManager();

      allow delete: if false;
    }


    // =========================================================
    // DOCUMENTS
    // =========================================================

    match /documents/{documentId} {
      allow read: if isServiceStaff();

      allow create, update: if isAdmin()
        || isManager()
        || isCSKH();

      allow delete: if false;
    }


    // =========================================================
    // AUDIT LOGS
    // =========================================================

    match /auditLogs/{logId} {
      allow read: if isAdmin()
        || isManager()
        || isDirector();

      allow create: if isServiceStaff();

      allow update, delete: if false;
    }


    // =========================================================
    // SETTINGS
    // =========================================================

    match /settings/{settingId} {
      allow read: if isServiceStaff();

      // Bộ đếm số phiếu PBM phải được cập nhật atomically bằng transaction.
      // Chỉ tài khoản có quyền tạo/sửa phiếu bảo trì được cập nhật đúng document này.
      allow create, update: if (settingId == 'maintenanceTicket' && (isAdmin() || isManager() || isTechnician()))
        || isAdmin();

      allow delete: if false;
    }


    // =========================================================
    // NOTIFICATIONS
    // =========================================================

    match /notifications/{notificationId} {
      allow read: if isServiceStaff();

      allow create: if isServiceStaff();

      allow update: if isServiceStaff();

      allow delete: if false;
    }


    // =========================================================
    // SERVICE AREAS
    // =========================================================

    match /serviceAreas/{areaId} {
      allow read: if isServiceStaff();

      allow create, update: if isAdmin()
        || isManager();

      allow delete: if false;
    }


    // =========================================================
    // MAINTENANCE SCHEDULES
    // =========================================================

    match /maintenanceSchedules/{scheduleId} {
      allow read: if isServiceStaff();

      allow create, update: if isAdmin()
        || isManager()
        || isTechnician();

      allow delete: if false;
    }


    // =========================================================
    // CHECKLIST TEMPLATES
    // =========================================================

    match /checklistTemplates/{templateId} {
      allow read: if isServiceStaff();

      allow create, update: if isAdmin()
        || isManager();

      allow delete: if false;
    }


    // =========================================================
    // SERVICE CONTRACTS — GIỮ TƯƠNG THÍCH DỮ LIỆU CŨ
    // =========================================================

    match /serviceContracts/{contractId} {
      allow read: if isServiceStaff();

      allow create, update: if isAdmin()
        || isManager()
        || isCSKH();

      allow delete: if false;
    }


    // =========================================================
    // MAINTENANCE AGREEMENTS — GIỮ TƯƠNG THÍCH DỮ LIỆU CŨ
    // =========================================================

    match /maintenanceAgreements/{agreementId} {
      allow read: if isServiceStaff();

      allow create, update: if isAdmin()
        || isManager()
        || isCSKH();

      allow delete: if false;
    }


    // =========================================================
    // DEFAULT DENY
    // =========================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
