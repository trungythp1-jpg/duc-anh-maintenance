rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn()
        ? get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.role
        : null;
    }

    function isAdmin() {
      return role() == 'ADMIN';
    }

    function isManager() {
      return role() == 'MANAGER';
    }

    function isDirector() {
      return role() == 'DIRECTOR';
    }

    function isCSKH() {
      return role() == 'CUSTOMER_SERVICE';
    }

    function isTechnician() {
      return role() == 'TECHNICIAN';
    }

    function isWarehouse() {
      return role() == 'WAREHOUSE';
    }

    function isManagement() {
      return isAdmin() || isManager() || isDirector();
    }

    function isServiceStaff() {
      return isAdmin()
        || isManager()
        || isTechnician()
        || isCSKH()
        || isDirector();
    }

    match /users/{userId} {
      allow read: if signedIn()
        && (isManagement() || request.auth.uid == userId);

      allow create: if isAdmin();

      allow update: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'displayName',
              'phone',
              'photoUrl',
              'updatedAt'
            ])
        );

      allow delete: if false;
    }

    match /companySettings/{companyId} {
      allow read: if signedIn();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /customers/{customerId} {
      allow read: if isServiceStaff();
      allow create, update: if isAdmin() || isManager() || isCSKH();
      allow delete: if false;
    }

    match /buildings/{buildingId} {
      allow read: if isServiceStaff();
      allow create, update: if isAdmin() || isManager() || isCSKH();
      allow delete: if false;
    }

    match /elevators/{elevatorId} {
      allow read: if isServiceStaff();
      allow create, update: if isAdmin() || isManager();
      allow delete: if false;
    }

    match /elevatorRelationships/{relationshipId} {
      allow read: if isServiceStaff();
      allow create, update: if isAdmin() || isManager();
      allow delete: if false;
    }

    /*
     * QUAN TRỌNG:
     *
     * contracts.html và firestore-v1.js dùng collection:
     *     contracts
     *
     * Rules cũ KHÔNG có match /contracts/{contractId}
     * nên Firestore rơi xuống DEFAULT DENY và báo:
     *     Missing or insufficient permissions.
     *
     * Thêm đúng collection này, không đổi sang
     * serviceContracts hoặc maintenanceAgreements.
     */
    match /contracts/{contractId} {
      allow read: if isServiceStaff();

      allow create, update: if isAdmin()
        || isManager()
        || isCSKH();

      allow delete: if false;
    }

    match /serviceAreas/{areaId} {
      allow read: if isServiceStaff();
      allow create, update: if isAdmin() || isManager();
      allow delete: if false;
    }

    match /serviceContracts/{contractId} {
      allow read: if isServiceStaff();
      allow create, update: if isAdmin() || isManager() || isCSKH();
      allow delete: if false;
    }

    match /maintenanceAgreements/{agreementId} {
      allow read: if isServiceStaff();
      allow create, update: if isAdmin() || isManager() || isCSKH();
      allow delete: if false;
    }

    match /maintenanceSchedules/{scheduleId} {
      allow read: if isServiceStaff();
      allow create, update: if isAdmin()
        || isManager()
        || isCSKH()
        || isTechnician();
      allow delete: if false;
    }

    match /checklistTemplates/{templateId} {
      allow read: if isServiceStaff();
      allow create, update: if isAdmin() || isManager();
      allow delete: if false;
    }

    match /workOrders/{workOrderId} {
      allow read: if isServiceStaff();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /workOrderMaintenanceLocks/{lockId} {
      allow read: if isManagement();
      allow create, update, delete: if false;
    }

    match /incidents/{incidentId} {
      allow read: if isServiceStaff();
      allow create, update: if isAdmin() || isManager() || isTechnician();
      allow delete: if false;
    }

    match /repairs/{repairId} {
      allow read: if isServiceStaff();
      allow create, update: if isAdmin() || isManager() || isTechnician();
      allow delete: if false;
    }

    match /parts/{partId} {
      allow read: if isServiceStaff();
      allow create, update: if isAdmin() || isManager() || isWarehouse();
      allow delete: if false;
    }

    match /technicianAssignments/{assignmentId} {
      allow read: if isServiceStaff();
      allow create, update: if isAdmin() || isManager();
      allow delete: if false;
    }

    match /assignmentChanges/{changeId} {
      allow read: if isManagement();
      allow create: if isAdmin() || isManager();
      allow update, delete: if false;
    }

    match /kpiPeriods/{periodId} {
      allow read: if isManagement() || isTechnician();
      allow create, update: if isAdmin() || isManager();
      allow delete: if false;
    }

    match /kpiTargets/{targetId} {
      allow read: if isManagement() || isTechnician();
      allow create, update: if false;
      allow delete: if false;
    }

    match /kpiActivities/{activityId} {
      allow read: if isManagement() || isTechnician();
      allow create, update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || isManagement());
      allow create, update: if false;
      allow delete: if false;
    }

    match /notificationRules/{ruleId} {
      allow read: if isManagement();
      allow create, update: if isAdmin() || isManager();
      allow delete: if false;
    }

    match /notificationLogs/{logId} {
      allow read: if isManagement();
      allow create, update, delete: if false;
    }

    match /customerNotificationPreferences/{customerId} {
      allow read: if isServiceStaff();
      allow create, update: if isAdmin() || isManager() || isCSKH();
      allow delete: if false;
    }

    match /customerPortalSessions/{sessionId} {
      allow read: if signedIn()
        && (isManagement() || resource.data.userId == request.auth.uid);
      allow create, update: if false;
      allow delete: if false;
    }

    match /customerConfirmations/{confirmationId} {
      allow read: if isServiceStaff();
      allow create, update: if false;
      allow delete: if false;
    }

    match /confirmationLocks/{workOrderId} {
      allow read: if isManagement();
      allow create, update, delete: if false;
    }

    match /importJobs/{importJobId} {
      allow read: if isManagement();
      allow create, update: if isAdmin() || isManager();
      allow delete: if false;
    }

    match /activityLogs/{logId} {
      allow read: if isManagement();
      allow create, update, delete: if false;
    }

    match /codeAdjustmentRequests/{requestId} {
      allow read: if isManagement();
      allow create, update: if isAdmin() || isManager();
      allow delete: if false;
    }

    match /systemCounters/{counterId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
