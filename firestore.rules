rules_version = '2';

// BUILD: WO-independent + KTV Maintenance completion workflow

service cloud.firestore {
  match /databases/{database}/documents {

    /*
     * ĐỨC ANH MAINTENANCE — MODULE 4.8
     * FIRESTORE RULES — TECHNICIAN SCOPE
     *
     * Mục tiêu:
     * - ADMIN / MANAGER giữ quyền quản lý đầy đủ theo Rules hiện tại.
     * - TECHNICIAN chỉ được đọc/sửa công việc được giao cho chính mình.
     * - Liên kết bảo mật:
     *     users/{uid}.technicianId
     *       ↓
     *     maintenance.technicianId
     *       hoặc
     *     workOrders.assignedTechnicianId
     *
     * LƯU Ý:
     * - technicianId là mã nghiệp vụ lâu dài.
     * - Firebase Auth UID chỉ là tài khoản đăng nhập.
     * - Không thêm technicianUid vào maintenance/workOrders.
     * - Trước khi dùng tài khoản TECHNICIAN thật, users/{uid}
     *   phải có technicianId đúng với technicians/{technicianId}.
     */

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    function hasUserDoc() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        );
    }

    function userRole() {
      return hasUserDoc()
        ? userDoc().data.role
        : null;
    }

    function isAdmin() {
      return signedIn()
        && userRole() in ['ADMIN', 'admin'];
    }

    function isManager() {
      return signedIn()
        && userRole() in ['MANAGER', 'manager'];
    }

    function isDirector() {
      return signedIn()
        && userRole() in ['DIRECTOR', 'director'];
    }

    function isCSKH() {
      return signedIn()
        && userRole() in [
          'CUSTOMER_SERVICE',
          'customer_service',
          'CSKH',
          'cskh'
        ];
    }

    function isTechnician() {
      return signedIn()
        && userRole() in ['TECHNICIAN', 'technician'];
    }

    function isWarehouse() {
      return signedIn()
        && userRole() in ['WAREHOUSE', 'warehouse'];
    }

    function technicianIdFromUser() {
      return hasUserDoc()
        ? userDoc().data.get('technicianId', '')
        : '';
    }

    function isAssignedTechnician(technicianId) {
      return isTechnician()
        && technicianIdFromUser() != ''
        && technicianId == technicianIdFromUser();
    }

    function isAssignedWorkOrder() {
      return isTechnician()
        && technicianIdFromUser() != ''
        && resource.data.assignedTechnicianId == technicianIdFromUser();
    }

    function isAssignedMaintenance() {
      return isTechnician()
        && technicianIdFromUser() != ''
        && resource.data.technicianId == technicianIdFromUser();
    }

    function isServiceStaff() {
      return isAdmin()
        || isManager()
        || isDirector()
        || isCSKH()
        || isTechnician();
    }


    // =========================================================
    // USERS
    // =========================================================

    match /users/{userId} {
      allow get: if signedIn()
        && (
          request.auth.uid == userId
          || isAdmin()
          || isManager()
          || isDirector()
        );

      allow list: if isAdmin()
        || isManager()
        || isDirector();

      allow create: if isAdmin();

      allow update: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'name',
              'displayName',
              'phone',
              'photoUrl',
              'updatedAt'
            ])
        );

      allow delete: if false;
    }


    // =========================================================
    // CUSTOMERS / BUILDINGS / ELEVATORS
    // =========================================================
    //
    // CSKH KHÔNG được trực tiếp tạo/sửa Customer/Building chính thức
    // trong workflow "khách hàng ngoài".
    //
    // Luồng chính thức:
    //   CSKH -> cskhRequests -> ADMIN duyệt
    //   -> ADMIN tạo Customer -> Building -> Elevator.
    //
    // CSKH vẫn được đọc dữ liệu master để tìm khách hàng hiện hữu.
    //

    match /customers/{customerId} {
      allow read: if isServiceStaff();
      allow create, update: if isAdmin()
        || isManager();
      allow delete: if false;
    }

    match /buildings/{buildingId} {
      allow read: if isServiceStaff();
      allow create, update: if isAdmin()
        || isManager();
      allow delete: if false;
    }

    match /elevators/{elevatorId} {
      allow read: if isServiceStaff();
      allow create, update: if isAdmin()
        || isManager();
      allow delete: if false;
    }

    match /elevatorRelationships/{relationshipId} {
      allow read: if isServiceStaff();
      allow create, update: if isAdmin()
        || isManager();
      allow delete: if false;
    }


    // =========================================================
    // CSKH REQUESTS
    // =========================================================
    //
    // Phiếu yêu cầu CSKH là lớp dữ liệu trung gian, KHÔNG phải
    // master data.
    //
    // Luồng:
    //   DRAFT
    //      ↓
    //   SUBMITTED
    //      ↓
    //   ADMIN_REVIEW
    //      ↓
    //   CREATED / DUPLICATE / NEED_INFO / REJECTED
    //
    // Client ADMIN được phép hoàn tất trực tiếp trên Spark/no-Blaze
    // sau khi đã tạo đủ Customer → Building → Elevator trong cùng batch.
    //
    // CSKH:
    //   - tạo phiếu của chính mình ở DRAFT.
    //   - đọc phiếu của chính mình.
    //   - sửa dữ liệu nghiệp vụ khi DRAFT / NEED_INFO.
    //   - không được tự sửa status/history/linked master IDs.
    //
    // ADMIN / MANAGER:
    //   - được đọc phiếu.
    // ADMIN:
    //   - tiếp nhận SUBMITTED -> ADMIN_REVIEW.
    //   - yêu cầu bổ sung SUBMITTED/ADMIN_REVIEW -> NEED_INFO.
    // ADMIN hoàn tất phiếu sau khi tạo đủ master data.
    //

    match /cskhRequests/{requestId} {
      allow get: if isAdmin()
        || isManager()
        || (
          isCSKH()
          && resource.data.createdByUid == request.auth.uid
        );

      allow list: if isAdmin()
        || isManager()
        || isCSKH();

      allow create: if
        isCSKH()
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.status == 'DRAFT'
        && request.resource.data.requestSource in [
          'EXISTING_CUSTOMER',
          'EXTERNAL_CUSTOMER'
        ]
        && request.resource.data.requestType in [
          'MAINTENANCE_REQUEST',
          'SERVICE_REQUEST',
          'CUSTOMER_REGISTRATION',
          'CONTRACT_REQUEST',
          'OTHER'
        ]
        && request.resource.data.assignedAdminUid == ''
        && request.resource.data.assignedAdminName == ''
        && request.resource.data.processedAt == null
        && request.resource.data.resultNote == '';

      // CSKH: sửa dữ liệu nghiệp vụ theo các trạng thái được phép.
      allow update: if
        isCSKH()
        && resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdByUid == resource.data.createdByUid
        && (
          (
            resource.data.status in ['DRAFT', 'NEED_INFO']
            && request.resource.data.status in ['DRAFT', 'NEED_INFO']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'requestSource',
              'requestType',
              'customerId',
              'buildingId',
              'elevatorId',
              'externalCustomer',
              'externalBuilding',
              'externalElevator',
              'externalContract',
              'description',
              'note',
              'history',
              'updatedAt'
            ])
            && request.resource.data.history.size()
               == resource.data.history.size() + 1
          )
          ||
          (
            resource.data.status == 'DRAFT'
            && request.resource.data.status == 'SUBMITTED'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status',
              'updatedAt',
              'history'
            ])
            && request.resource.data.history.size()
               == resource.data.history.size() + 1
          )
          ||
          (
            resource.data.status == 'SUBMITTED'
            && request.resource.data.status == 'SUBMITTED'
            && resource.data.assignedAdminUid == ''
            && request.resource.data.assignedAdminUid == ''
            && resource.data.processedAt == null
            && request.resource.data.processedAt == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'requestSource',
              'requestType',
              'customerId',
              'buildingId',
              'elevatorId',
              'externalCustomer',
              'externalBuilding',
              'externalElevator',
              'externalContract',
              'description',
              'note',
              'history',
              'updatedAt'
            ])
            && request.resource.data.history.size()
               == resource.data.history.size() + 1
          )
        );

      // ADMIN: tiếp nhận phiếu SUBMITTED -> ADMIN_REVIEW.
      // Không dùng Cloud Functions; phù hợp Spark / no-Blaze.
      allow update: if
        isAdmin()
        && request.resource.data.createdByUid == resource.data.createdByUid
        && resource.data.status == 'SUBMITTED'
        && request.resource.data.status == 'ADMIN_REVIEW'
        && resource.data.assignedAdminUid == ''
        && resource.data.processedAt == null
        && request.resource.data.assignedAdminUid == request.auth.uid
        && request.resource.data.assignedAdminName is string
        && request.resource.data.processedAt == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'assignedAdminUid',
          'assignedAdminName',
          'updatedAt',
          'history'
        ])
        && request.resource.data.history.size()
           == resource.data.history.size() + 1;

      // ADMIN: hoàn tất phiếu sau khi đã tạo đủ 3 master data.
      // ADMIN_REVIEW -> CREATED, đồng thời liên kết Customer / Building / Elevator.
      allow update: if
        isAdmin()
        && request.resource.data.createdByUid == resource.data.createdByUid
        && resource.data.status == 'ADMIN_REVIEW'
        && request.resource.data.status == 'CREATED'
        && resource.data.assignedAdminUid == request.auth.uid
        && request.resource.data.assignedAdminUid == request.auth.uid
        && request.resource.data.customerId is string
        && request.resource.data.customerId.size() > 0
        && request.resource.data.buildingId is string
        && request.resource.data.buildingId.size() > 0
        && request.resource.data.elevatorId is string
        && request.resource.data.elevatorId.size() > 0
        && request.resource.data.processedAt != null
        && request.resource.data.resultNote is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'customerId',
          'buildingId',
          'elevatorId',
          'processedAt',
          'resultNote',
          'updatedAt',
          'history'
        ])
        && request.resource.data.history.size()
           == resource.data.history.size() + 1;

      // ADMIN: yêu cầu CSKH bổ sung thông tin.
      // Có thể từ SUBMITTED hoặc ADMIN_REVIEW -> NEED_INFO.
      allow update: if
        isAdmin()
        && request.resource.data.createdByUid == resource.data.createdByUid
        && resource.data.status in ['SUBMITTED', 'ADMIN_REVIEW']
        && request.resource.data.status == 'NEED_INFO'
        && resource.data.processedAt == null
        && request.resource.data.processedAt == null
        && request.resource.data.assignedAdminUid == request.auth.uid
        && request.resource.data.assignedAdminName is string
        && request.resource.data.resultNote is string
        && request.resource.data.resultNote.size() > 0
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'assignedAdminUid',
          'assignedAdminName',
          'resultNote',
          'updatedAt',
          'history'
        ])
        && request.resource.data.history.size()
           == resource.data.history.size() + 1;

      allow delete: if false;

      allow delete: if false;
    }


    // =========================================================
    // CONTRACTS
    // =========================================================

    match /contracts/{contractId} {
      allow read: if isServiceStaff();

      allow create, update: if isAdmin()
        || isManager()
        || isCSKH();

      allow delete: if false;
    }


    // =========================================================
    // MAINTENANCE
    // =========================================================
    //
    // ADMIN / MANAGER:
    //   đọc và sửa toàn bộ.
    //
    // TECHNICIAN:
    //   chỉ được đọc/sửa PBM có technicianId đúng bằng
    //   users/{uid}.technicianId.
    //
    // Query TECHNICIAN phải dùng:
    // where("technicianId", "==", users/{uid}.technicianId)
    //
    // Firestore Rules không phải bộ lọc; query không có constraint
    // phù hợp sẽ bị từ chối.
    //

    match /maintenance/{maintenanceId} {

      allow get: if isAdmin()
        || isManager()
        || isDirector()
        || isCSKH()
        || isAssignedMaintenance();

      allow list: if isAdmin()
        || isManager()
        || isDirector()
        || isCSKH()
        || isAssignedMaintenance();

      allow create: if
        (isAdmin() || isManager())
        ||
        (
          isTechnician()
          && request.resource.data.technicianId == technicianIdFromUser()
          && request.resource.data.technicianId != ''
          && request.resource.data.status in ['assigned', 'in_progress']
          && request.resource.data.completedByTechnicianId == ''
          && request.resource.data.completedByTechnicianName == ''
          && request.resource.data.completionReportedAt == null
          && request.resource.data.customerConfirmationStatus == 'not_started'
          && request.resource.data.customerConfirmationDeadline == null
          && request.resource.data.customerConfirmedBy == ''
          && request.resource.data.customerConfirmedAt == null
          && request.resource.data.confirmationEscalatedBy == ''
          && request.resource.data.confirmationEscalatedAt == null
        );

      allow update: if
        (isAdmin() || isManager())
        ||
        (
          isAssignedMaintenance()
          && request.resource.data.technicianId
             == resource.data.technicianId
          && request.resource.data.technicianId
             == technicianIdFromUser()
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.buildingId == resource.data.buildingId
          && request.resource.data.elevatorId == resource.data.elevatorId
          && request.resource.data.contractId == resource.data.contractId
          && request.resource.data.periodNumber == resource.data.periodNumber
          && (
            (
              resource.data.status in ['assigned', 'in_progress']
              && request.resource.data.status == 'waiting_confirmation'
              && request.resource.data.completedByTechnicianId
                 == technicianIdFromUser()
              && request.resource.data.completedByTechnicianName
                 != ''
              && request.resource.data.completionReportedAt != null
              && request.resource.data.customerConfirmationStatus == 'pending'
              && request.resource.data.customerConfirmationDeadline != null
              && request.resource.data.customerConfirmedBy == ''
              && request.resource.data.customerConfirmedAt == null
              && request.resource.data.confirmationEscalatedBy == ''
              && request.resource.data.confirmationEscalatedAt == null
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'completedDate',
                'status',
                'completedByTechnicianId',
                'completedByTechnicianName',
                'completionReportedAt',
                'customerConfirmationStatus',
                'customerConfirmationDeadline',
                'customerConfirmedBy',
                'customerConfirmedAt',
                'customerConfirmationNote',
                'confirmationEscalatedBy',
                'confirmationEscalatedAt',
                'updatedAt'
              ])
            )
            ||
            (
              resource.data.status in ['assigned', 'in_progress']
              && request.resource.data.status in ['assigned', 'in_progress']
              && request.resource.data.completedByTechnicianId
                 == resource.data.completedByTechnicianId
              && request.resource.data.completedByTechnicianName
                 == resource.data.completedByTechnicianName
              && request.resource.data.completionReportedAt
                 == resource.data.completionReportedAt
              && request.resource.data.customerConfirmationStatus
                 == resource.data.customerConfirmationStatus
              && request.resource.data.customerConfirmationDeadline
                 == resource.data.customerConfirmationDeadline
              && request.resource.data.customerConfirmedBy
                 == resource.data.customerConfirmedBy
              && request.resource.data.customerConfirmedAt
                 == resource.data.customerConfirmedAt
              && request.resource.data.confirmationEscalatedBy
                 == resource.data.confirmationEscalatedBy
              && request.resource.data.confirmationEscalatedAt
                 == resource.data.confirmationEscalatedAt
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'customerId','customerName',
                'buildingId','buildingName',
                'elevatorId','elevatorName','elevatorAssetCode',
                'contractId','contractCode','periodNumber',
                'scheduledDate','completedDate','status',
                'technicianId','technicianName',
                'checklist','condition','result','issueFound','note',
                'latestWorkOrderId','latestWorkOrderNo',
                'latestWorkOrderStatus','workOrderIds','workOrderCount',
                'updatedAt'
              ])
            )
          )
        )
        ||
        (
          isCSKH()
          && resource.data.status == 'waiting_confirmation'
          && resource.data.customerConfirmationStatus == 'pending'
          && request.resource.data.status == 'completed'
          && request.resource.data.customerConfirmationStatus == 'confirmed'
          && request.resource.data.completedByTechnicianId
             == resource.data.completedByTechnicianId
          && request.resource.data.completedByTechnicianName
             == resource.data.completedByTechnicianName
          && request.resource.data.technicianId
             == resource.data.technicianId
          && request.resource.data.customerConfirmedBy != ''
          && request.resource.data.customerConfirmedAt != null
          && request.time <= resource.data.customerConfirmationDeadline
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'customerConfirmationStatus',
            'customerConfirmedBy',
            'customerConfirmedAt',
            'customerConfirmationNote',
            'updatedAt'
          ])
        )
        ||
        (
          false
        );

      allow delete: if false;
    }


    // =========================================================
    // WORK ORDERS — V2
    // =========================================================

    match /workOrders/{workOrderId} {
      allow get: if isAdmin()
        || isManager()
        || isDirector()
        || isCSKH()
        || isAssignedWorkOrder();

      allow list: if isAdmin()
        || isManager()
        || isDirector()
        || isCSKH()
        || isAssignedWorkOrder();

      allow create: if
        (isAdmin() || isManager() || isDirector() || isCSKH())
        && request.resource.data.sourceType in [
          'MAINTENANCE',
          'CUSTOMER_REPORT',
          'INCIDENT',
          'SALES',
          'MANAGEMENT',
          'OTHER'
        ]
        && request.resource.data.type in [
          'MAINTENANCE', 'BREAKDOWN', 'REPAIR', 'INSPECTION'
        ]
        && request.resource.data.priority in [
          'low', 'normal', 'high', 'urgent'
        ]
        && request.resource.data.status in [
          'draft', 'assigned', 'in_progress', 'waiting_parts', 'completed', 'cancelled'
        ]
        && request.resource.data.customerId != ''
        && request.resource.data.buildingId != ''
        && request.resource.data.elevatorId != ''
        && (
          request.resource.data.sourceType != 'MAINTENANCE'
          || (
            request.resource.data.maintenanceId != ''
            && exists(
              /databases/$(database)/documents/maintenance/$(request.resource.data.maintenanceId)
            )
            && get(
              /databases/$(database)/documents/maintenance/$(request.resource.data.maintenanceId)
            ).data.customerId == request.resource.data.customerId
            && get(
              /databases/$(database)/documents/maintenance/$(request.resource.data.maintenanceId)
            ).data.buildingId == request.resource.data.buildingId
            && get(
              /databases/$(database)/documents/maintenance/$(request.resource.data.maintenanceId)
            ).data.elevatorId == request.resource.data.elevatorId
          )
        );

      allow update: if
        (
          (isAdmin() || isManager())
          && request.resource.data.sourceType in [
            'MAINTENANCE', 'CUSTOMER_REPORT', 'INCIDENT', 'SALES', 'MANAGEMENT', 'OTHER'
          ]
          && request.resource.data.type in [
            'MAINTENANCE', 'BREAKDOWN', 'REPAIR', 'INSPECTION'
          ]
          && request.resource.data.priority in [
            'low', 'normal', 'high', 'urgent'
          ]
          && request.resource.data.status in [
            'draft', 'assigned', 'in_progress', 'waiting_parts', 'completed', 'cancelled'
          ]
          && request.resource.data.customerId != ''
          && request.resource.data.buildingId != ''
          && request.resource.data.elevatorId != ''
          && (
            request.resource.data.sourceType != 'MAINTENANCE'
            || (
              request.resource.data.maintenanceId != ''
              && exists(
                /databases/$(database)/documents/maintenance/$(request.resource.data.maintenanceId)
              )
              && get(
                /databases/$(database)/documents/maintenance/$(request.resource.data.maintenanceId)
              ).data.customerId == request.resource.data.customerId
              && get(
                /databases/$(database)/documents/maintenance/$(request.resource.data.maintenanceId)
              ).data.buildingId == request.resource.data.buildingId
              && get(
                /databases/$(database)/documents/maintenance/$(request.resource.data.maintenanceId)
              ).data.elevatorId == request.resource.data.elevatorId
            )
          )
        )
        || (
          isAssignedWorkOrder()
          && request.resource.data.assignedTechnicianId
             == resource.data.assignedTechnicianId
          && request.resource.data.assignedTechnicianId
             == technicianIdFromUser()
          && request.resource.data.sourceType
             == resource.data.sourceType
          && request.resource.data.customerId
             == resource.data.customerId
          && request.resource.data.buildingId
             == resource.data.buildingId
          && request.resource.data.elevatorId
             == resource.data.elevatorId
          && request.resource.data.contractId
             == resource.data.contractId
          && request.resource.data.maintenanceId
             == resource.data.maintenanceId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'type',
            'priority',
            'status',
            'issueTitle',
            'problemDescription',
            'openedDate',
            'dueDate',
            'completedDate',
            'completedAt',
            'cause',
            'resolution',
            'materials',
            'laborCost',
            'materialCost',
            'totalCost',
            'attachmentUrls',
            'note',
            'updatedAt'
          ])
        );

      allow delete: if false;
    }


    // =========================================================
    // TECHNICIANS
    // =========================================================

    match /technicians/{technicianId} {
      allow get: if isAdmin()
        || isManager()
        || isDirector()
        || isCSKH()
        || isAssignedTechnician(technicianId);

      allow list: if isAdmin()
        || isManager()
        || isDirector()
        || isCSKH()
        || (
          isTechnician()
          && technicianIdFromUser() != ''
          && resource.data.technicianId == technicianIdFromUser()
        );

      allow create, update: if isAdmin()
        || isManager();

      allow delete: if false;
    }


    // =========================================================
    // KPI
    // =========================================================

    match /kpi/{kpiId} {
      allow read: if isServiceStaff();
      allow create, update: if isAdmin()
        || isManager();
      allow delete: if false;
    }


    // =========================================================
    // DOCUMENTS
    // =========================================================

    match /documents/{documentId} {
      allow read: if isServiceStaff();
      allow create, update: if isAdmin()
        || isManager()
        || isCSKH();
      allow delete: if false;
    }


    // =========================================================
    // WORK ORDER REQUESTS — V2
    // =========================================================

    match /workOrderRequests/{requestId} {
      allow get: if isAdmin()
        || isManager()
        || isDirector()
        || isCSKH()
        || (
          isTechnician()
          && resource.data.requestedByTechnicianId == technicianIdFromUser()
        );

      allow list: if isAdmin()
        || isManager()
        || isDirector()
        || isCSKH();

      allow create: if
        isTechnician()
        && request.resource.data.sourceType in [
          'MAINTENANCE',
          'CUSTOMER_REPORT',
          'INCIDENT',
          'SALES',
          'MANAGEMENT',
          'OTHER'
        ]
        && request.resource.data.requestedByTechnicianId
           == technicianIdFromUser()
        && request.resource.data.requestedByUid
           == request.auth.uid
        && request.resource.data.status == 'PENDING'
        && request.resource.data.type in [
          'MAINTENANCE', 'BREAKDOWN', 'REPAIR', 'INSPECTION'
        ]
        && request.resource.data.priority in [
          'low', 'normal', 'high', 'urgent'
        ]
        && request.resource.data.customerId != ''
        && request.resource.data.buildingId != ''
        && request.resource.data.elevatorId != ''
        && (
          request.resource.data.sourceType != 'MAINTENANCE'
          || (
            request.resource.data.maintenanceId != ''
            && exists(
              /databases/$(database)/documents/maintenance/$(request.resource.data.maintenanceId)
            )
            && get(
              /databases/$(database)/documents/maintenance/$(request.resource.data.maintenanceId)
            ).data.technicianId == technicianIdFromUser()
          )
        );

      allow update: if
        (isAdmin() || isManager())
        && request.resource.data.status in [
          'PENDING', 'APPROVED', 'REJECTED', 'CONVERTED'
        ]
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'createdWorkOrderId',
          'createdWorkOrderNo',
          'processedByUid',
          'processedByName',
          'processedAt',
          'updatedAt'
        ]);

      allow delete: if false;
    }


    // =========================================================
    // AUDIT LOGS
    // =========================================================

    match /auditLogs/{logId} {
      allow read: if isAdmin()
        || isManager()
        || isDirector();

      allow create: if isServiceStaff();

      allow update, delete: if false;
    }


    // =========================================================
    // SETTINGS
    // =========================================================

    match /settings/{settingId} {
      allow read: if isServiceStaff();

      allow create: if
        (settingId == 'maintenanceTicket'
          && (isAdmin() || isManager() || isTechnician()))
        || isAdmin()
        || (
          settingId == 'materialQuoteCounter'
          && isCSKH()
          && request.resource.data.prefix == 'BGVT-'
          && request.resource.data.year is int
          && request.resource.data.lastNumber == 1
          && request.resource.data.updatedAt != null
        );

      allow update: if
        (settingId == 'maintenanceTicket'
          && (isAdmin() || isManager() || isTechnician()))
        || isAdmin()
        || (
          settingId == 'materialQuoteCounter'
          && isCSKH()
          && request.resource.data.prefix == 'BGVT-'
          && request.resource.data.year is int
          && request.resource.data.lastNumber is int
          && request.resource.data.updatedAt != null
          && (
            (
              request.resource.data.year == resource.data.year
              && request.resource.data.lastNumber == resource.data.lastNumber + 1
            )
            || (
              request.resource.data.year > resource.data.year
              && request.resource.data.lastNumber == 1
            )
          )
        );

      allow delete: if false;
    }


    // =========================================================
    // NOTIFICATIONS
    // =========================================================

    match /notifications/{notificationId} {
      allow read: if isServiceStaff();
      allow create: if isServiceStaff();
      allow update: if isServiceStaff();
      allow delete: if false;
    }


    // =========================================================
    // SERVICE AREAS
    // =========================================================

    match /serviceAreas/{areaId} {
      allow read: if isServiceStaff();
      allow create, update: if isAdmin()
        || isManager();
      allow delete: if false;
    }


    // =========================================================
    // MAINTENANCE SCHEDULES
    // =========================================================

    match /maintenanceSchedules/{scheduleId} {
      allow read: if isServiceStaff();

      allow create, update: if isAdmin()
        || isManager();

      allow delete: if false;
    }


    // =========================================================
    // CHECKLIST TEMPLATES
    // =========================================================

    match /checklistTemplates/{templateId} {
      allow read: if isServiceStaff();

      allow create, update: if isAdmin()
        || isManager();

      allow delete: if false;
    }


    // =========================================================
    // SERVICE CONTRACTS — COMPATIBILITY
    // =========================================================

    match /serviceContracts/{contractId} {
      allow read: if isServiceStaff();

      allow create, update: if isAdmin()
        || isManager()
        || isCSKH();

      allow delete: if false;
    }


    // =========================================================
    // MAINTENANCE AGREEMENTS — COMPATIBILITY
    // =========================================================

    match /maintenanceAgreements/{agreementId} {
      allow read: if isServiceStaff();

      allow create, update: if isAdmin()
        || isManager()
        || isCSKH();

      allow delete: if false;
    }


    // =========================================================
    // MATERIAL QUOTES — CSKH
    // =========================================================
    //
    // CSKH tạo báo giá vật tư từ Work Order.
    // Mã BGVT do client sinh thông qua counter transaction.
    // Counter chỉ được tăng đúng +1, không cho sửa tùy ý.
    //
    match /materialQuotes/{quoteId} {
      allow get, list: if isServiceStaff();

      allow create: if
        isCSKH()
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.status == 'DRAFT'
        && request.resource.data.quoteNo is string
        && request.resource.data.quoteNo.matches('BGVT-[0-9]{4}-[0-9]{6}')
        && request.resource.data.workOrderId != ''
        && request.resource.data.customerId != ''
        && request.resource.data.buildingId != ''
        && request.resource.data.elevatorId != ''
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.total >= 0;

      allow update: if
        isCSKH()
        && resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.quoteNo == resource.data.quoteNo
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'items',
          'subtotal',
          'discount',
          'vatRate',
          'vatAmount',
          'total',
          'validityDays',
          'note',
          'status',
          'updatedAt'
        ]);

      allow delete: if false;
    }

    // =========================================================
    // DEFAULT DENY
    // =========================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
